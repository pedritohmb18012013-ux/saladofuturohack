    .ad-zone {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: flex-start;
      gap: 16px;
      margin-top: 20px;
    }
    .ad-slot { min-height: 1px; overflow: hidden; }
    .ad-slot--728x90 { width: 728px; max-width: 100%; min-height: 90px; }
    .ad-slot--320x50 { width: 320px; max-width: 100%; min-height: 50px; }
    .ad-slot--300x250 { width: 300px; max-width: 100%; min-height: 250px; }
    .ad-slot--160x300 { width: 160px; max-width: 100%; min-height: 300px; }

    @media (max-width: 760px) {
      body:not(.splash-active) { overflow-x: hidden; overflow-y: auto; }
    }

    .logo-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 18px;
      text-align: center;
      position: relative;
      min-height: 96px;
    }

    .logo-img { width: 220px; height: auto; display: block; transform: translateY(14px) scale(1.3); }

    .logo-cmsp {
      opacity: 0;
      visibility: hidden;
      transform: translateY(14px) scale(0.08, 1.3);
      transform-origin: center center;
    }

    .logo-cmsp.is-revealed {
      visibility: visible;
      animation: cmsp-reveal 0.72s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes cmsp-reveal {
      0% { opacity: 0; transform: translateY(14px) scale(0.08, 1.3); }
      100% { opacity: 1; transform: translateY(14px) scale(1.3); }
    }

    .logo-splash {
      position: fixed;
      left: 50%;
      top: 50%;
      z-index: 10000;
      width: 108px;
      height: auto;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transform: translate(-50%, -50%);
      will-change: transform, opacity;
    }

    body:not(.splash-active) .logo-splash { display: none; }
    body.splash-active .login-card,
    body.splash-active .login-discord-link,
    body.splash-active .login-turnstile { opacity: 0; visibility: hidden; pointer-events: none; }

    body:not(.splash-active) .login-card,
    body:not(.splash-active) .login-discord-link,
    body:not(.splash-active) .login-turnstile { animation: login-in 0.45s ease both; }

    @keyframes login-in { from { opacity: 0; } to { opacity: 1; } }

    .login-header { text-align: center; margin-bottom: 20px; }
    .login-header h1 { font-size: 20px; font-weight: 700; letter-spacing: -0.4px; margin-bottom: 6px; }
    .login-header p { font-size: 14px; color: var(--text-secondary); }

    .login-form { display: grid; grid-template-columns: 1fr; row-gap: 0; }
    .login-form > label { display: block; font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; }

    .ra-field { grid-column: 1; margin-bottom: 14px; }
    .ra-row { display: flex; align-items: flex-end; gap: 5px; }
    .ra-wrap { flex: 1; min-width: 0; }
    .ra-input-wrap { min-width: 0; }
    .digito-wrap { flex: 0 0 44px; position: relative; z-index: 2; }
    .uf-wrap { flex: 0 0 52px; position: relative; z-index: 3; }
    .digito-wrap .field-mini-label, .uf-wrap .field-mini-label { text-align: center; }
    .uf-select { position: relative; }
    .form-input.form-input-uf {
      width: 100%;
      padding: 14px 22px 14px 0;
      text-align: center;
      font-weight: 600;
      cursor: pointer;
      appearance: none;
    }
    .uf-trigger { position: relative; }
    .uf-trigger::after {
      content: "";
      position: absolute;
      right: 8px;
      top: 50%;
      width: 0;
      height: 0;
      border-left: 4px solid transparent;
      border-right: 4px solid transparent;
      border-top: 5px solid var(--text-muted);
      transform: translateY(-30%);
      pointer-events: none;
    }
    .uf-dropdown {
      position: absolute; top: calc(100% + 6px); left: 0; right: 0;
      max-height: 220px; overflow-y: auto; margin: 0; padding: 6px 0;
      list-style: none; background: #f9f9f9; border: 1px solid rgba(0,0,0,0.08);
      border-radius: 10px; box-shadow: 0 12px 32px rgba(0,0,0,0.35); z-index: 20;
    }
    .uf-dropdown[hidden] { display: none; }
    .uf-dropdown li button {
      width: 100%; padding: 8px 12px; border: none; background: transparent;
      color: #3f3f3f; font-family: inherit; font-size: 14px; font-weight: 600;
      text-align: center; cursor: pointer;
    }
    .uf-dropdown li button:hover,
    .uf-dropdown li button.selected { background: #e8e8e8; color: #4f4f4f; }

    .field-mini-label {
      display: block; font-size: 10px; font-weight: 600;
      color: var(--text-muted); line-height: 1; margin-bottom: 8px;
    }
    .ra-wrap .field-mini-label { text-align: left; }
    .senha-input-wrap { margin-bottom: 18px; }
    .input-wrap { position: relative; }

    .input-wrap svg {
      position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
      width: 18px; height: 18px; color: var(--text-muted); pointer-events: none;
    }

    .form-input {
      width: 100%; padding: 14px 14px 14px 44px;
      background: rgba(255,255,255,0.04); border: 1px solid var(--border);
      border-radius: var(--radius-sm); font-family: inherit; font-size: 15px;
      color: var(--text); outline: none; transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    .form-input::placeholder { color: var(--text-muted); }
    .form-input.form-input-digito { width: 100%; padding: 14px 0; text-align: center; font-weight: 600; }
    .form-input:focus {
      border-color: rgba(86, 86, 86, 0.6); background: rgba(86, 86, 86, 0.08);
      box-shadow: 0 0 0 3px rgba(86, 86, 86, 0.15);
    }

    .password-toggle {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: transparent; border: none; color: var(--text); cursor: pointer;
      padding: 4px; display: flex; align-items: center; justify-content: center;
      transition: color 0.15s;
    }
    .password-toggle:hover { color: var(--text-secondary); }
    .password-toggle svg { position: static; transform: none; width: 18px; height: 18px; }
    .form-input.has-toggle { padding-right: 44px; }

    .btn-login {
      width: 100%; margin-top: 0; padding: 12px 20px; background: #3e3e3e;
      color: white; border: none; border-radius: var(--radius-sm);
      font-family: inherit; font-size: 15px; font-weight: 600; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      transition: background 0.15s, transform 0.12s, box-shadow 0.15s;
    }
    .btn-login:hover {
      background: #2f2f2f; transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    }
    .btn-login:active { transform: translateY(0); }
    .btn-login svg { width: 18px; height: 18px; }

    .login-error {
      display: none; margin-bottom: 14px; padding: 12px 14px;
      border-radius: var(--radius-sm); background: rgba(119, 119, 119, 0.12);
      border: 1px solid rgba(119, 119, 119, 0.25); color: #bfbfbf; font-size: 13px; line-height: 1.45;
    }
    .login-error.visible { display: block; }
    .btn-login:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
    .btn-login:disabled:hover { background: #3e3e3e; transform: none; box-shadow: none; }

    .login-turnstile { display: flex; justify-content: center; margin: 4px 0 14px; }

    /* `label.termos-check` (não só `.termos-check`) de propósito: precisa
       empatar em especificidade com `.login-form > label` (linha acima, que
       também tem um seletor de tipo) pra ganhar pela ordem no arquivo — só
       com a classe, o `display: block` daquela regra vencia e a caixinha e o
       texto empilhavam em vez de ficar lado a lado. */
    label.termos-check {
      display: flex; align-items: flex-start; gap: 10px; margin: 0 0 14px;
      cursor: pointer; user-select: none;
    }
    .termos-check input { position: absolute; opacity: 0; width: 0; height: 0; }
    .termos-check-box {
      flex: 0 0 auto; width: 20px; height: 20px; margin-top: 1px; border-radius: 6px;
      border: 2px solid rgba(255,255,255,0.28); background: rgba(255,255,255,0.04);
      display: flex; align-items: center; justify-content: center;
      transition: background 0.15s ease, border-color 0.15s ease;
    }
    .termos-check-box svg { width: 13px; height: 13px; color: #fff; opacity: 0; transform: scale(0.6); transition: opacity 0.15s ease, transform 0.15s ease; }
    .termos-check input:checked + .termos-check-box { background: #7c5cff; border-color: #7c5cff; }
    .termos-check input:checked + .termos-check-box svg { opacity: 1; transform: scale(1); }
    .termos-check input:focus-visible + .termos-check-box { outline: 2px solid #7c5cff; outline-offset: 2px; }
    .termos-check:hover .termos-check-box { border-color: rgba(255,255,255,0.45); }
    .termos-check-texto { font-size: 13px; line-height: 1.5; color: rgba(255,255,255,0.7); }
    .termos-link {
      background: none; border: 0; padding: 0; font: inherit; cursor: pointer;
      color: #fff; font-weight: 600; text-decoration: underline; text-underline-offset: 2px;
    }
    .termos-link:hover { color: rgba(255,255,255,0.8); }
    /* Pisca quando o aluno tenta entrar sem marcar — sem isso o botão fica
       desabilitado e não fica claro POR QUE. */
    .termos-check.termos-faltando .termos-check-box { border-color: #ff6b6b; animation: termos-shake 0.4s ease; }
    .termos-check.termos-faltando .termos-check-texto { color: #ff9d9d; }
    @keyframes termos-shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      75% { transform: translateX(4px); }
    }

    .termos-modal { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .termos-modal[hidden] { display: none; }
    .termos-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.72); backdrop-filter: blur(3px); }
    .termos-card {
      position: relative; width: 100%; max-width: 640px; max-height: 86vh;
      display: flex; flex-direction: column;
      background: #141418; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.6); overflow: hidden;
    }
    .termos-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 20px 12px; }
    .termos-header h2 { margin: 0; font-size: 18px; color: #fff; }
    .termos-close { background: none; border: 0; color: rgba(255,255,255,0.55); font-size: 18px; cursor: pointer; line-height: 1; padding: 4px; }
    .termos-close:hover { color: #fff; }
    .termos-tabs { display: flex; gap: 6px; padding: 0 20px 12px; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .termos-tab {
      flex: 1; padding: 9px 10px; border-radius: 9px; cursor: pointer; font-size: 13px; font-weight: 600;
      background: rgba(255,255,255,0.04); border: 1px solid transparent; color: rgba(255,255,255,0.6);
    }
    .termos-tab:hover { color: #fff; }
    .termos-tab.is-active { background: rgba(124,92,255,0.16); border-color: rgba(124,92,255,0.5); color: #fff; }
    .termos-corpo {
      overflow-y: auto; padding: 16px 20px 20px; font-size: 13.5px; line-height: 1.65;
      color: rgba(255,255,255,0.78); scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.16) transparent;
    }
    .termos-corpo::-webkit-scrollbar { width: 6px; }
    .termos-corpo::-webkit-scrollbar-track { background: transparent; }
    .termos-corpo::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.16); border-radius: 3px; }
    .termos-corpo::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.28); }
    .termos-corpo h3 { margin: 20px 0 6px; font-size: 14px; color: #fff; }
    .termos-corpo h3:first-of-type { margin-top: 10px; }
    .termos-corpo p { margin: 0 0 10px; }
    .termos-corpo ul { margin: 0 0 10px; padding-left: 20px; }
    .termos-corpo li { margin-bottom: 7px; }
    .termos-corpo strong { color: #fff; }
    .termos-meta { font-size: 12px; color: rgba(255,255,255,0.4); margin-bottom: 12px !important; }
    .termos-lead { color: rgba(255,255,255,0.9); }
    .termos-alerta {
      background: rgba(255,107,107,0.1); border-left: 3px solid #ff6b6b;
      padding: 9px 12px; border-radius: 0 8px 8px 0; color: #ffc9c9; font-weight: 600;
    }
    .termos-rodape { padding: 14px 20px 18px; border-top: 1px solid rgba(255,255,255,0.08); }
    .termos-aceitar { margin: 0; }

    @media (max-width: 480px) {
