  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg: #030303;
      --card: #0d0d0d;
      --border: rgba(255,255,255,0.08);
      --accent: #565656;
      --accent-hover: #484848;
      --accent-light: #717171;
      --text: #f4f4f4;
      --text-secondary: #989898;
      --text-muted: #5f5f5f;
      --radius: 18px;
      --radius-sm: 12px;
    }

    html, body {
      min-height: 100vh;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    body {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 16px;
      background: var(--bg);
      overflow-x: hidden;
      overflow-y: auto;
    }

    @media (min-width: 761px) {
      body:not(.splash-active) {
        min-height: 100dvh;
        overflow-y: auto;
        padding: 12px 180px;
      }
      .login-wrap { margin-top: auto; margin-bottom: auto; padding: 12px 0; }
    }

    body::-webkit-scrollbar { width: 5px; }
    body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 3px; }

    .bg-lights {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }

    .light-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(140px);
      will-change: transform;
    }

    .light-orb-1 { width: 480px; height: 480px; background: rgba(86, 86, 86, 0.35); animation: edge-orbit-1 120s linear infinite; }
    .light-orb-2 { width: 400px; height: 400px; background: rgba(86, 86, 86, 0.28); animation: edge-orbit-2 150s linear infinite; }
    .light-orb-3 { width: 360px; height: 360px; background: rgba(86, 86, 86, 0.22); animation: edge-orbit-3 100s linear infinite; }
    .light-orb-4 { width: 320px; height: 320px; background: rgba(86, 86, 86, 0.18); animation: edge-orbit-4 135s linear infinite; }

    /* blur(140px) animado em 4 elementos grandes derruba o WebKit no iOS
       (renderer crash / "problema ocorreu repetidamente"). É só decoração,
       então desliga em telas pequenas em vez de arriscar. */
    @media (max-width: 760px) {
      .bg-lights { display: none; }
    }

    @keyframes edge-orbit-1 {
      0%   { top: -12%; left: -8%; }
      25%  { top: -12%; left: 78%; }
      50%  { top: 78%; left: 78%; }
      75%  { top: 78%; left: -8%; }
      100% { top: -12%; left: -8%; }
    }
    @keyframes edge-orbit-2 {
      0%   { top: 82%; left: 85%; }
      25%  { top: -10%; left: 85%; }
      50%  { top: -10%; left: -5%; }
      75%  { top: 82%; left: -5%; }
      100% { top: 82%; left: 85%; }
    }
    @keyframes edge-orbit-3 {
      0%   { top: 50%; left: -15%; }
      25%  { top: -8%; left: 50%; }
      50%  { top: 50%; left: 92%; }
      75%  { top: 88%; left: 50%; }
      100% { top: 50%; left: -15%; }
    }
    @keyframes edge-orbit-4 {
      0%   { top: -8%; left: 40%; }
      25%  { top: 40%; left: 90%; }
      50%  { top: 88%; left: 55%; }
      75%  { top: 45%; left: -10%; }
      100% { top: -8%; left: 40%; }
    }

    .login-wrap {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 400px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .login-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 24px 22px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.4);
      width: 100%;
    }

    body.splash-active { overflow: hidden; }

    body.splash-active .ad-side,
    body.splash-active .ad-zone { opacity: 0; visibility: hidden; }

    body:not(.splash-active) .ad-side,
    body:not(.splash-active) .ad-zone { animation: login-in 0.45s ease both; }

    .ad-side {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      z-index: 1;
      display: none;
    }
    @media (min-width: 900px) {
      .ad-side { display: block; }
