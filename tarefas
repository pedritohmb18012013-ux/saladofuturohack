    .saved-accounts-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
    .saved-accounts-header h2 { font-size: 18px; font-weight: 700; color: var(--text); }
    .saved-accounts-close {
      width: 32px; height: 32px; border-radius: 10px; border: none;
