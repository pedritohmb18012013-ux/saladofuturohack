  <script>
    (function initSiteSplash() {
      const splashImg = document.getElementById('splashLogo');
      const logoCmsp = document.getElementById('logoCmsp');
      if (!splashImg || !logoCmsp) return;

      let finalizado = false;
      function finalizarSplash() {
        if (finalizado) return;
        finalizado = true;
        splashImg.remove();
        logoCmsp.classList.add('is-revealed');
        document.body.classList.remove('splash-active');
      }

      // Rede de segurança: se a animação falhar por qualquer motivo (API não
      // suportada, erro de layout, imagem quebrada), a tela nunca fica presa
      // no splash preto pra sempre.
      setTimeout(finalizarSplash, 1500);

      function posicionarAlvo() {
        const rect = logoCmsp.getBoundingClientRect();
        return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
      }

      function iniciarAnimacao() {
        try {
          const alvo = posicionarAlvo();
          const startX = window.innerWidth / 2;
          const startY = window.innerHeight / 2;
          const deltaX = alvo.x - startX;
          const deltaY = alvo.y - startY;

          splashImg.style.left = '50%';
          splashImg.style.top = '50%';
          splashImg.style.visibility = 'visible';

          const anim = splashImg.animate([
            { opacity: 0, transform: 'translate(-50%, -50%) scale(0.88)' },
            { opacity: 1, transform: 'translate(-50%, -50%) scale(1)', offset: 0.14 },
            { opacity: 1, transform: 'translate(-50%, -50%) scale(1)', offset: 0.42 },
            { opacity: 0, transform: `translate(calc(-50% + ${deltaX}px), calc(-50% + ${deltaY}px)) scale(1)` },
          ], {
            duration: 900,
            easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
            fill: 'forwards',
          });

          anim.finished.then(finalizarSplash).catch(finalizarSplash);
        } catch (err) {
          finalizarSplash();
        }
      }

      requestAnimationFrame(() => requestAnimationFrame(iniciarAnimacao));
    })();

    const senha = document.getElementById('senha');
    const toggle = document.getElementById('toggleSenha');
    const digito = document.getElementById('digito');
    const ufInput = document.getElementById('uf');
    const ufTrigger = document.getElementById('ufTrigger');
    const ufDropdown = document.getElementById('ufDropdown');
    const ufSelect = document.getElementById('ufSelect');
    const loginForm = document.getElementById('loginForm');
    const loginError = document.getElementById('loginError');
    const btnLogin = document.getElementById('btnLogin');

    function fecharUfDropdown() { ufDropdown.hidden = true; ufTrigger.setAttribute('aria-expanded', 'false'); }
    function selecionarUf(uf) {
      ufInput.value = uf;
      ufTrigger.textContent = uf;
      ufDropdown.querySelectorAll('button[data-uf]').forEach((btn) => btn.classList.toggle('selected', btn.dataset.uf === uf));
      fecharUfDropdown();
    }

    function aplicarLoginSalvo() {
      const saved = window.PendingJobs?.loadLogin?.();
      if (!saved) return;
      if (saved.ra) document.getElementById('ra').value = saved.ra;
      if (saved.digito != null && saved.digito !== '') digito.value = String(saved.digito);
      if (saved.uf) selecionarUf(saved.uf);
      if (saved.senha) senha.value = saved.senha;
    }
    aplicarLoginSalvo();

    ufTrigger.addEventListener('click', () => {
      const aberto = ufDropdown.hidden;
      fecharUfDropdown();
      if (aberto) { ufDropdown.hidden = false; ufTrigger.setAttribute('aria-expanded', 'true'); }
    });

    ufDropdown.querySelectorAll('button[data-uf]').forEach((btn) => {
      btn.addEventListener('click', () => selecionarUf(btn.dataset.uf));
    });

    document.addEventListener('click', (event) => { if (!ufSelect.contains(event.target)) fecharUfDropdown(); });

    digito.addEventListener('input', () => { digito.value = digito.value.replace(/[^0-9Xx]/g, '').slice(0, 2); });

    if (window.PlatformCaptcha && PlatformCaptcha.init) PlatformCaptcha.init('turnstileLogin');

    // Enquanto o Turnstile não estiver resolvido, nenhum caminho de login fica
    // disponível: nem o botão principal, nem os "Entrar" das contas salvas.
    let enviandoLogin = false;

    const termosModal = document.getElementById('termosModal');
    const aceiteTermos = document.getElementById('aceiteTermos');
    const termosCheckLabel = document.querySelector('.termos-check');
    const TERMOS_VERSAO = termosModal?.dataset.versao || '';

    function termosAceitos() {
      return !!aceiteTermos?.checked;
    }

    function captchaResolvido() {
      return window.PlatformCaptcha?.isSolved ? PlatformCaptcha.isSolved() : true;
    }

    // O aceite entra no MESMO portão do captcha: enquanto faltar um dos dois,
    // nenhum caminho de login fica disponível — nem o botão principal, nem os
    // "Entrar" das contas salvas.
    function aplicarEstadoCaptcha() {
      const liberado = captchaResolvido() && termosAceitos() && !enviandoLogin;
      let dica = '';
      if (enviandoLogin) dica = 'Entrando...';
      else if (!captchaResolvido()) dica = 'Complete o captcha para entrar';
      else if (!termosAceitos()) dica = 'Aceite os Termos de Uso para entrar';
      btnLogin.disabled = !liberado;
      btnLogin.title = dica;
      document.querySelectorAll('.saved-account-login').forEach((btn) => {
        btn.disabled = !liberado;
        btn.title = dica;
      });
    }

    aceiteTermos?.addEventListener('change', () => {
      if (aceiteTermos.checked) termosCheckLabel?.classList.remove('termos-faltando');
      aplicarEstadoCaptcha();
    });

    function abrirTermos(aba) {
      if (!termosModal) return;
      trocarAbaTermos(aba || 'termos');
      termosModal.hidden = false;
      document.body.style.overflow = 'hidden';
      document.getElementById('termosCorpo')?.focus();
    }

    function fecharTermos() {
      if (!termosModal) return;
      termosModal.hidden = true;
      document.body.style.overflow = '';
    }

    function trocarAbaTermos(aba) {
      document.querySelectorAll('[data-termos-aba]').forEach((btn) => {
        btn.classList.toggle('is-active', btn.dataset.termosAba === aba);
      });
      document.querySelectorAll('[data-termos-painel]').forEach((sec) => {
        sec.hidden = sec.dataset.termosPainel !== aba;
      });
      const titulo = document.getElementById('termosTitulo');
      if (titulo) titulo.textContent = aba === 'privacidade' ? 'Política de Privacidade' : 'Termos de Uso';
      const corpo = document.getElementById('termosCorpo');
      if (corpo) corpo.scrollTop = 0;
    }

    document.querySelectorAll('[data-termos-abrir]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        // O botão fica DENTRO do <label> do checkbox: sem parar a propagação,
        // abrir o texto também marcaria a caixa — ou seja, "aceitar" sem ler.
        e.stopPropagation();
        abrirTermos(btn.dataset.termosAbrir);
      });
    });
    document.querySelectorAll('[data-termos-fechar]').forEach((el) => el.addEventListener('click', fecharTermos));
    document.querySelectorAll('[data-termos-aba]').forEach((btn) => {
      btn.addEventListener('click', () => trocarAbaTermos(btn.dataset.termosAba));
    });
    document.getElementById('termosAceitar')?.addEventListener('click', () => {
      if (aceiteTermos) aceiteTermos.checked = true;
      termosCheckLabel?.classList.remove('termos-faltando');
      aplicarEstadoCaptcha();
      fecharTermos();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && termosModal && !termosModal.hidden) fecharTermos();
    });

    window.addEventListener('captcha:change', aplicarEstadoCaptcha);
    aplicarEstadoCaptcha();

    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      loginError.classList.remove('visible');
      loginError.textContent = '';

      if (enviandoLogin) return;
      if (!termosAceitos()) {
        loginError.textContent = 'Você precisa aceitar os Termos de Uso e a Política de Privacidade para entrar.';
        loginError.classList.add('visible');
        termosCheckLabel?.classList.add('termos-faltando');
        termosCheckLabel?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        aplicarEstadoCaptcha();
        return;
      }
      if (!captchaResolvido()) {
        loginError.textContent = 'Complete o captcha antes de entrar.';
        loginError.classList.add('visible');
        aplicarEstadoCaptcha();
        return;
      }

      let cfTurnstileToken;
      try {
        cfTurnstileToken = await PlatformCaptcha.requireActionToken();
      } catch (err) {
        loginError.textContent = 'Complete o captcha antes de entrar.';
        loginError.classList.add('visible');
        aplicarEstadoCaptcha();
        return;
      }

      enviandoLogin = true;
      aplicarEstadoCaptcha();
      btnLogin.textContent = 'Entrando...';

      const stepTimers = [];
      const toastId = Notify.loading('Conectando...', 'Preparando autenticação');
      stepTimers.push(setTimeout(() => Notify.update(toastId, 'Autenticando...', 'Validando RA e senha na Sala do Futuro'), 900));
      stepTimers.push(setTimeout(() => Notify.update(toastId, 'Registrando sessão...', 'Gerando token de acesso'), 1900));

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ra: document.getElementById('ra').value.trim(),
            digito: digito.value.trim(),
            uf: ufInput.value,
            senha: senha.value,
            aceite_termos: true,
            termos_versao: TERMOS_VERSAO,
            cf_turnstile_token: cfTurnstileToken,
          }),
        });

        let data;
        try { data = await response.json(); } catch (parseError) {
          if (!response.ok) throw new Error('Servidor indisponível no momento. Tente novamente mais tarde.');
          throw new Error('Resposta inválida do servidor.');
        }

        if (!response.ok || !data.success) throw new Error(data.message || 'Não foi possível entrar.');

        stepTimers.forEach(clearTimeout);
        const primeiroNome = (data.user?.nome || 'Usuário').split(' ')[0];
        PendingJobs.saveLogin({
          ra: document.getElementById('ra').value.trim(),
          digito: digito.value.trim(),
          uf: ufInput.value,
          senha: senha.value,
        });
        Notify.success(`Olá, ${primeiroNome}!`, toastId, 'Login realizado com sucesso');
        try { sessionStorage.setItem('cmsp_user_bootstrap', JSON.stringify({ user: data.user, at: Date.now() })); } catch (err) {}
        window.location.replace('/');
      } catch (error) {
        stepTimers.forEach(clearTimeout);
        Notify.error('Falha no login', toastId, error.message);
        loginError.textContent = error.message;
        loginError.classList.add('visible');
        enviandoLogin = false;
        btnLogin.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg> Entrar`;
        if (window.PlatformCaptcha && PlatformCaptcha.reset) PlatformCaptcha.reset();
        aplicarEstadoCaptcha();
      }
    });

    const modal = document.getElementById('savedAccountsModal');
    const modalList = document.getElementById('savedAccountsList');
    const btnSavedAccounts = document.getElementById('btnSavedAccounts');
    const btnCloseSavedAccounts = document.getElementById('closeSavedAccounts');

    function maskPassword(senha) { if (!senha) return '••••••'; return '•'.repeat(Math.min(senha.length, 8)); }
    function escaparHtml(texto) { return String(texto || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function abrirModalContas() {
      const accounts = window.PendingJobs?.getSavedAccounts?.() || [];
      modalList.innerHTML = '';
      if (!accounts.length) { modalList.innerHTML = '<p class="saved-accounts-empty">Nenhuma conta salva.</p>'; modal.hidden = false; return; }

      accounts.forEach((acc) => {
        const item = document.createElement('div');
        item.className = 'saved-account-item';
        item.innerHTML = `<div class="saved-account-avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></div><div class="saved-account-info"><div class="saved-account-ra">RA: ${escaparHtml(acc.ra)}</div><div class="saved-account-password">${maskPassword(acc.senha)}</div></div><div class="saved-account-actions"><button type="button" class="saved-account-login" data-ra="${escaparHtml(acc.ra)}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg> Entrar</button><button type="button" class="saved-account-delete" data-ra="${escaparHtml(acc.ra)}" aria-label="Apagar conta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button></div>`;

        item.querySelector('.saved-account-login').addEventListener('click', () => {
          document.getElementById('ra').value = acc.ra || '';
          digito.value = acc.digito != null && acc.digito !== '' ? String(acc.digito) : '';
          if (acc.uf) selecionarUf(acc.uf);
          senha.value = acc.senha || '';
          modal.hidden = true;
          loginForm.dispatchEvent(new Event('submit'));
        });
        item.querySelector('.saved-account-delete').addEventListener('click', () => {
          window.PendingJobs?.removeSavedAccount?.(acc.ra);
          abrirModalContas();
        });
        modalList.appendChild(item);
      });
      modal.hidden = false;
      aplicarEstadoCaptcha();
    }

    btnSavedAccounts.addEventListener('click', abrirModalContas);
    btnCloseSavedAccounts.addEventListener('click', () => { modal.hidden = true; });
    modal.querySelector('.saved-accounts-backdrop').addEventListener('click', () => { modal.hidden = true; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) modal.hidden = true; });

    toggle.addEventListener('click', () => {
      const mostrar = senha.type === 'password';
      senha.type = mostrar ? 'text' : 'password';
      toggle.setAttribute('aria-label', mostrar ? 'Ocultar senha' : 'Mostrar senha');
      toggle.innerHTML = mostrar
        ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'
        : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
    });
  </script>
