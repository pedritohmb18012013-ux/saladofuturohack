    async function carregarResumoInicio() {
      const pendenciasTotal = document.getElementById('pendenciasTotal');
      const pendenciasDetalhe = document.getElementById('pendenciasDetalhe');
      const faltasTotal = document.getElementById('faltasTotal');
      const faltasDetalhe = document.getElementById('faltasDetalhe');
      const cardPendencias = document.getElementById('cardPendencias');
      const cardFaltas = document.getElementById('cardFaltas');
      if (!pendenciasTotal) return;

      try {
        const response = await fetch('/api/inicio/resumo', { credentials: 'same-origin' });
        const data = await response.json();
        const pendencias = data.pendencias || {};
        const faltas = data.faltas || {};
        const avisos = data.avisos || {};

        if (response.ok && data.success) {
          App.setPendenciasResumo(pendencias);
          App.setFaltasResumo(faltas);
          pendenciasTotal.textContent = String(pendencias.total ?? 0);
          pendenciasDetalhe.textContent = avisos.pendencias ? 'Não foi possível atualizar' : formatarPendenciasDetalhe(pendencias);
          faltasTotal.textContent = String(faltas.total ?? 0);
          faltasDetalhe.textContent = avisos.faltas ? 'Não foi possível atualizar' : formatarFaltasDetalhe(faltas);
        } else {
          throw new Error(data.message || 'Erro ao carregar');
        }
      } catch (error) {
        pendenciasTotal.textContent = '—';
        pendenciasDetalhe.textContent = 'Indisponível';
        faltasTotal.textContent = '—';
        faltasDetalhe.textContent = 'Indisponível';
      } finally {
        cardPendencias?.classList.remove('is-loading');
        cardFaltas?.classList.remove('is-loading');
      }
    }

    let _donationsData = [];
    let _rankingData = [];
    let _abaDoacoesAtiva = true;

    function renderizarDoacoes(items) {
      const topName = document.getElementById('topDonorName');
      const topAmount = document.getElementById('topDonorAmount');
      const lista = document.getElementById('donorList');
      const loading = document.getElementById('donationsLoading');
