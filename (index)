  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/site.css" />
  <style id="page-style">
    .page-content {
      width: 100%;
      min-height: calc(100dvh - 80px);
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--donations-col, 340px);
      gap: 24px;
      align-items: start;
    }

    .donations-col {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-width: 0;
      align-self: start;
    }

    .content-col {
      display: flex;
      flex-direction: column;
      gap: 24px;
      min-width: 0;
      min-height: 100%;
    }

    .content-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .donations-side {
      --donor-row-h: 56px;
      display: flex;
      flex-direction: column;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 26px 24px;
      width: 100%;
      align-self: stretch;
    }

    .donations-side h3 { font-size: 15px; font-weight: 700; margin-bottom: 16px; }

    .home-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    .home-stat-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 18px 16px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      min-width: 0;
      text-decoration: none;
      color: inherit;
    }

    a.home-stat-card:hover { background: var(--card-hover); border-color: var(--border-light); }

    .home-stat-head { display: flex; align-items: center; gap: 7px; }
    .home-stat-head svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--text-muted); }
    .home-stat-label { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
    .home-stat-value { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; line-height: 1; color: var(--text); }
    .home-stat-sub { font-size: 12px; line-height: 1.35; color: var(--text-secondary); }
    .home-stat-card.is-loading .home-stat-value { font-size: 16px; color: var(--text-muted); }
    .home-stat-card--pendencias .home-stat-head svg { color: #a0a0a0; }
    .home-stat-card--faltas .home-stat-head svg { color: #a8a8a8; }
    button.home-stat-card { width: 100%; text-align: left; cursor: pointer; font-family: inherit; }

    .top-donor {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 11px 13px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-bottom: 16px;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .top-donor svg { width: 18px; height: 18px; color: #bfbfbf; flex-shrink: 0; }
    .top-donor-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .top-donor-label { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
    .top-donor .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; color: var(--text); }
    .top-donor .amt { font-weight: 700; color: var(--text); white-space: nowrap; }

    .donor-list { display: flex; flex-direction: column; flex: 1; min-height: calc(var(--donor-row-h) * 10); }
    .donor-row {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 14px 0;
      border-top: 1px solid var(--border);
    }
    .donor-item:first-child .donor-row { border-top: none; padding-top: 0; }

    .donor-av {
      width: 40px; height: 40px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 15px; font-weight: 700; color: white; flex-shrink: 0;
    }
    .donor-info { flex: 1; min-width: 0; }
    .donor-info .n { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .donor-info .msg { font-size: 11px; color: var(--text-muted); margin-top: 2px; line-height: 1.4; word-break: break-word; }
    .donor-info .msg--expansivel { word-break: break-word; }
    .donor-info .msg-toggle { background: none; border: none; padding: 0; margin-left: 2px; color: var(--purple); font-family: inherit; font-size: 11px; font-weight: 600; cursor: pointer; }
    .donor-info .msg-toggle:hover { text-decoration: underline; }
    .donor-info .msg-reply { font-size: 11px; color: var(--text-secondary); margin-top: 3px; padding-left: 8px; border-left: 2px solid var(--purple); line-height: 1.4; word-break: break-word; }
    .donor-info .tags { display: flex; gap: 4px; margin-top: 2px; }
    .donor-info .tags span { font-size: 11px; }
    .donor-amt { text-align: right; flex-shrink: 0; }
    .donor-amt .price { font-size: 14px; font-weight: 700; color: var(--green); }
    .donor-amt .time { font-size: 11px; color: var(--text-muted); margin-top: 2px; }


    .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); }

    .welcome-card {
      padding: 36px 40px;
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .welcome-card h1 { font-size: 34px; font-weight: 700; letter-spacing: -0.5px; line-height: 1.2; }
    .welcome-card p { font-size: 13px; color: var(--text-secondary); letter-spacing: 0.06em; text-transform: uppercase; margin-top: 4px; font-weight: 500; }
    .avatar.lg { width: 68px; height: 68px; font-size: 26px; }

    .donation-card {
      padding: 24px 36px 28px;
      background: linear-gradient(135deg, #1b1b1b 0%, #323232 50%, #191919 100%);
      border: 1px solid rgba(86, 86, 86, 0.3);
      border-radius: var(--radius);
      position: relative;
      overflow: hidden;
    }
    .donation-card::after {
      content: '';
      position: absolute;
      top: -60px;
      right: -30px;
      width: 220px;
      height: 220px;
      background: radial-gradient(circle, rgba(113, 113, 113, 0.22) 0%, transparent 65%);
      pointer-events: none;
    }
    .donation-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; position: relative; z-index: 1; }
    .donation-logo-wrap { height: 64px; overflow: hidden; display: flex; align-items: center; }
    .donation-logo { height: 80px; width: auto; object-fit: contain; object-position: left center; display: block; }
    .donation-logo-text { font-size: 20px; font-weight: 700; letter-spacing: -0.3px; color: #fff; }
    .donation-stats { text-align: right; }
    .donation-stats .val { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }
    .donation-meta { margin-top: 6px; font-size: 14px; }
    .donation-meta .meta-label { color: #fff; font-weight: 500; }
    .donation-card h2 { font-size: 24px; font-weight: 700; letter-spacing: -0.4px; margin-bottom: 8px; position: relative; z-index: 1; }
    .donation-card .desc { font-size: 15px; color: rgba(255,255,255,0.55); line-height: 1.6; max-width: 540px; margin-bottom: 20px; position: relative; z-index: 1; }

    .donation-apoio {
      position: relative;
      z-index: 1;
      margin-bottom: 20px;
    }
    .apoio-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 7px; flex-wrap: wrap; }
    .apoio-right { display: flex; align-items: center; gap: 12px; }
    .apoio-label { font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.6); }
    .apoio-label.is-full { color: #69f0ae; }
    .apoio-val { font-size: 13px; font-weight: 700; color: #fff; white-space: nowrap; }
    .apoio-track { height: 5px; border-radius: 999px; background: rgba(255,255,255,0.1); overflow: hidden; }
    .apoio-fill { height: 100%; width: 0%; border-radius: 999px; background: var(--purple); transition: width 0.6s ease; }
    .apoio-fill.is-full { background: #00c853; }

    .btn-apoio-benef {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 0;
      background: none;
      border: none;
      border-radius: 0;
      color: rgba(255,255,255,0.55);
      font-family: inherit;
      font-size: 12.5px;
      font-weight: 500;
      cursor: pointer;
      transition: color 0.15s;
    }
    .btn-apoio-benef svg, .btn-apoio-benef img { width: 16px; height: 16px; flex-shrink: 0; object-fit: contain; }
    .btn-apoio-benef:hover { color: rgba(255,255,255,0.85); }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 24px;
      background: var(--purple);
      color: white;
      border: none;
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s, transform 0.12s, box-shadow 0.15s;
      position: relative;
      z-index: 1;
    }
    .btn-primary svg, .btn-primary .btn-icon { width: 18px; height: 18px; color: #fff; flex-shrink: 0; }
    .btn-primary:hover { background: #484848; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(86, 86, 86, 0.4); }

    .donation-card-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; position: relative; z-index: 1; }

    .btn-ver-doacoes {
      display: none;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 12px 24px;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: var(--radius-sm);
      background: rgba(255,255,255,0.08);
      color: #fff;
      font-family: inherit;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }
    .btn-ver-doacoes svg { width: 18px; height: 18px; flex-shrink: 0; color: #fff; }
    .btn-ver-doacoes:hover { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.16); }

    .section-label { font-size: 16px; font-weight: 600; color: var(--text-secondary); margin-bottom: 14px; }
    .section-label.uppercase { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); font-weight: 700; }

    .platform-item {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 28px 26px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, transform 0.12s;
    }
    .platform-item:hover { background: var(--card-hover); border-color: var(--border-light); transform: translateY(-1px); }
    .platform-item .item-icon { width: 52px; height: 52px; flex-shrink: 0; border-radius: 13px; overflow: hidden; }
    .platform-item .item-icon img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .platform-item .item-text h4 { font-size: 18px; font-weight: 600; margin-bottom: 6px; }
    .platform-item .item-text p { font-size: 13px; line-height: 1.5; color: var(--text-muted); }
    .item-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

    .platform-item.is-disabled { cursor: default; opacity: 0.55; filter: grayscale(0.4); }
    .platform-item.is-disabled:hover { background: var(--card); border-color: var(--border); transform: none; }
    .platform-item .item-text h4 { display: flex; align-items: center; gap: 8px; }
    .platform-badge { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); background: rgba(255,255,255,0.06); border: 1px solid var(--border); padding: 2px 8px; border-radius: 999px; white-space: nowrap; }
    .platform-badge.is-update { color: #d0a54a; background: rgba(208,165,74,0.14); border-color: rgba(208,165,74,0.35); }
    .platform-badge.is-apoiador { color: #69f0ae; background: rgba(105,240,174,0.12); border-color: rgba(105,240,174,0.35); }
    .platform-item.is-update { opacity: 0.7; }
    .platform-item.is-update:hover { background: var(--card); border-color: var(--border); transform: none; }

    .platforms-section { flex: 1; display: flex; flex-direction: column; width: 100%; }
    .platform-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      flex: 1;
      align-content: start;
    }
    .platform-loading, .platform-empty {
      grid-column: 1 / -1;
      padding: 28px 20px;
      text-align: center;
      color: var(--text-secondary);
      font-size: 14px;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.02);
    }

    body.plataformas-page .platform-grid { grid-template-columns: 1fr; gap: 14px; }
    body.plataformas-page .platform-item { padding: 22px 24px; }
    body.plataformas-page .welcome-card,
    body.plataformas-page .home-stats,
    body.plataformas-page .donation-card,
    body.plataformas-page .donations-col { display: none; }
    body.plataformas-page .page-content { grid-template-columns: 1fr; }

    .donations-tabs { display: flex; gap: 8px; margin-bottom: 18px; }
    .donations-tab {
      flex: 1;
      padding: 10px 14px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text-secondary);
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .donations-tab:hover { background: rgba(255,255,255,0.06); color: var(--text); }
    .donations-tab.active { background: var(--purple-active); border-color: rgba(86, 86, 86, 0.4); color: var(--text); }

    .donations-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      min-height: calc(var(--donor-row-h) * 10);
      padding: 40px 0;
      color: var(--text-muted);
      font-size: 13px;
    }
    .donations-spinner { width: 32px; height: 32px; border: 3px solid rgba(86, 86, 86, 0.2); border-top-color: var(--purple); border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    @media (min-width: 961px) {
      .donations-side {
        --donor-row-h: 42px;
        padding: 14px 16px 16px;
        align-self: start;
        max-height: none;
        overflow: visible;
      }
      .donations-side h3 { font-size: 13px; margin-bottom: 8px; }
      .donations-tabs { gap: 6px; margin-bottom: 10px; }
      .donations-tab { padding: 7px 10px; font-size: 12px; border-radius: 8px; }
      .top-donor { gap: 8px; padding: 8px 10px; margin-bottom: 10px; font-size: 11px; border-radius: 10px; }
      .top-donor svg { width: 15px; height: 15px; }
      .top-donor-label { font-size: 9px; }
      .top-donor .name { font-size: 12px; }
      .top-donor .amt { font-size: 12px; }
      .donor-list { flex: 0 0 auto; min-height: calc(var(--donor-row-h) * 10); max-height: none; overflow: visible; }
      .donor-row { gap: 8px; min-height: var(--donor-row-h); padding: 0; flex-shrink: 0; }
      .donor-av { width: 30px; height: 30px; font-size: 12px; }
      .donor-info .n { font-size: 12px; line-height: 1.2; }
      .donor-amt .price { font-size: 12px; line-height: 1.2; }
      .donor-amt .time { font-size: 10px; line-height: 1.1; margin-top: 0; }
      .donations-loading { gap: 10px; min-height: calc(var(--donor-row-h) * 10); padding: 0; font-size: 12px; }
      .donations-spinner { width: 24px; height: 24px; }
    }

    @media (max-width: 1100px) { .platform-grid { grid-template-columns: 1fr 1fr; } }

    @media (max-width: 960px) {
      .page-content { grid-template-columns: 1fr; }
      .donations-col { width: 100%; }
      .donations-side { min-height: calc(var(--donor-row-h) * 10 + 240px); max-height: none; overflow: visible; }
      .platform-grid { grid-template-columns: 1fr; }
      .welcome-card { padding: 24px; }
      .welcome-card h1 { font-size: 26px; }
      .donation-card { padding: 20px 24px 24px; }
      .donation-top { flex-direction: column; align-items: flex-start; gap: 12px; }
      .donation-stats { text-align: left; }
      .donation-card-actions { width: 100%; }
      .donation-card .btn-primary, .btn-ver-doacoes { width: 100%; justify-content: center; }
      .btn-ver-doacoes { display: inline-flex; }
      .donations-side { scroll-margin-top: calc(var(--mobile-top-h) + 12px); }
    }
  </style>
</head>
