      const lista = document.getElementById('faltasCategorias');
      const subtitulo = document.getElementById('faltasPopupSub');
      if (!lista) return;
      const disciplinas = faltas?.disciplinas || [];
      const total = Number(faltas?.total || 0);
      if (!disciplinas.length) {
        if (subtitulo) subtitulo.textContent = total ? 'Detalhes por matéria indisponíveis.' : 'Nenhuma falta no bimestre atual.';
