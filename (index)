    function configurarAbasDoacoes() {
      const lista = document.getElementById('donorList');
      if (lista && !lista.dataset.toggleLigado) {
        lista.dataset.toggleLigado = '1';
        lista.addEventListener('click', (e) => {
          const btn = e.target.closest('.msg-toggle');
          if (!btn) return;
          const wrap = btn.closest('.msg--expansivel');
          const span = wrap && wrap.querySelector('.msg-texto');
          if (!span) return;
          const expandido = wrap.classList.toggle('expandido');
          span.innerHTML = expandido ? span.dataset.completo : span.dataset.curto;
          btn.textContent = expandido ? 'ler menos' : 'ler mais';
        });
      }

      const tabDoacoes = document.getElementById('tabDoacoes');
      const tabRanking = document.getElementById('tabRanking');
      if (!tabDoacoes || !tabRanking) return;
      tabDoacoes.addEventListener('click', () => {
        _abaDoacoesAtiva = true;
        tabDoacoes.classList.add('active');
        tabRanking.classList.remove('active');
        atualizarAbaDoacoes();
      });
      tabRanking.addEventListener('click', () => {
        _abaDoacoesAtiva = false;
        tabRanking.classList.add('active');
        tabDoacoes.classList.remove('active');
        atualizarAbaDoacoes();
      });
