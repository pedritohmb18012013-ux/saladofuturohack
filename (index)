    const PROMO_POPUPS_COOLDOWN_MS = 10 * 60 * 1000;
    const PROMO_POPUPS_STORAGE_KEY = 'cmsp_promo_popups_last';
    const PARTNER_CLOSE_COUNTDOWN_S = 3;
    let promoAoFechar = null;
    let partnerCountdownTimer = null;

    function podeMostrarPromoPopups() {
      try {
        const last = Number(localStorage.getItem(PROMO_POPUPS_STORAGE_KEY) || 0);
        return Date.now() - last >= PROMO_POPUPS_COOLDOWN_MS;
      } catch (err) { return true; }
    }
    function marcarPromoPopupsVistos() {
      try { localStorage.setItem(PROMO_POPUPS_STORAGE_KEY, String(Date.now())); } catch (err) {}
    }

    function fecharPopupDiscord() {
      const overlay = document.getElementById('discordPopup');
      const closeBtn = document.getElementById('discordPopupClose');
      if (!overlay || !overlay.classList.contains('open')) return;
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
      if (closeBtn) closeBtn.disabled = false;
      const next = promoAoFechar;
      promoAoFechar = null;
      if (typeof next === 'function') setTimeout(next, 400);
      else window.App?.syncOverlayScrollLock?.();
    }

    function fecharPopupParceria() {
      const overlay = document.getElementById('partnerPopup');
      const closeBtn = document.getElementById('partnerPopupClose');
      if (!overlay || !overlay.classList.contains('open')) return;
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
      if (partnerCountdownTimer) { clearInterval(partnerCountdownTimer); partnerCountdownTimer = null; }
      if (closeBtn) { closeBtn.classList.remove('visible'); closeBtn.disabled = true; closeBtn.textContent = '✕'; }
      const next = promoAoFechar;
      promoAoFechar = null;
      if (typeof next === 'function') setTimeout(next, 400);
      else window.App?.syncOverlayScrollLock?.();
    }

    function iniciarCountdownFechar(overlay, closeBtn, onTimer) {
      let restante = PARTNER_CLOSE_COUNTDOWN_S;
      closeBtn.classList.add('visible');
      closeBtn.disabled = true;
      closeBtn.textContent = String(restante);
      const timer = setInterval(() => {
        if (!overlay.classList.contains('open')) { clearInterval(timer); onTimer(null); return; }
        restante -= 1;
        if (restante > 0) closeBtn.textContent = String(restante);
        else {
          clearInterval(timer);
          onTimer(null);
          closeBtn.textContent = '✕';
          closeBtn.disabled = false;
        }
      }, 1000);
      onTimer(timer);
    }

    function abrirPopupParceria() {
      const overlay = document.getElementById('partnerPopup');
      const closeBtn = document.getElementById('partnerPopupClose');
      if (!overlay || !closeBtn) return;
      if (partnerCountdownTimer) clearInterval(partnerCountdownTimer);
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      iniciarCountdownFechar(overlay, closeBtn, (t) => { partnerCountdownTimer = t; });
      promoAoFechar = window.UsuarioApoiador ? null : abrirPopupApoiador;
    }

    function abrirPopupPD() {
      const overlay = document.getElementById('pdPopup');
      // Sem o elemento, segue a cadeia em vez de travá-la no meio.
      if (!overlay) return abrirPopupParceria();
      promoAoFechar = abrirPopupParceria;
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      window.App?.lockPageScroll?.();
