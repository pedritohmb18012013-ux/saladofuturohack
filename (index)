    const LIMITE_MSG_DOADOR = 60;

    function htmlMensagemDoador(texto) {
      const msg = String(texto || '').trim();
      if (!msg) return '';
      if (msg.length <= LIMITE_MSG_DOADOR) {
        return `<div class="msg">${escapeHtml(msg)}</div>`;
      }
      const curto = escapeHtml(msg.slice(0, LIMITE_MSG_DOADOR).trimEnd()) + '…';
      const completo = escapeHtml(msg);
      return `<div class="msg msg--expansivel">`
        + `<span class="msg-texto" data-curto="${curto}" data-completo="${completo}">${curto}</span>`
        + `<button type="button" class="msg-toggle">ler mais</button>`
        + `</div>`;
    }

    function corGradienteValor(t) {
      const o = [255, 140, 0];
      const g = [0, 200, 83];
      const r = Math.round(o[0] + (g[0] - o[0]) * t);
      const gg = Math.round(o[1] + (g[1] - o[1]) * t);
      const b = Math.round(o[2] + (g[2] - o[2]) * t);
      return `rgb(${r},${gg},${b})`;
    }

    function htmlLinhaDoador(item, index, extraAmt, avatarBadge, priceColor) {
      const nome = escapeHtml(item.payerName || 'Anônimo');
      const valor = formatarMoeda(item.amount);
      const corPreco = priceColor ? `style="color:${priceColor};"` : '';
      const inicial = escapeHtml(inicialDoador(item.payerName));
      const mensagem = htmlMensagemDoador(item.message);
      const resposta = item.reply ? `<div class="msg-reply">${escapeHtml(item.reply)}</div>` : '';
      return `<div class="donor-item">
        <div class="donor-row">
          <div class="donor-av" style="background:${corAvatarDoador(index)};position:relative;">${inicial}${avatarBadge || ''}</div>
          <div class="donor-info"><div class="n">${nome}</div>${mensagem}${resposta}</div>
          <div class="donor-amt"><div class="price" ${corPreco}>${valor}</div>${extraAmt || ''}</div>
        </div>
      </div>`;
    }

