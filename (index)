    function renderizarModalPendencias(pendencias) {
      const lista = document.getElementById('pendenciasCategorias');
      const subtitulo = document.getElementById('pendenciasPopupSub');
      if (!lista) return;
      const tarefas = Number(pendencias?.tarefas || 0);
      const redacoes = Number(pendencias?.redacoes || 0);
      const provas = Number(pendencias?.provas || 0);
      const totalTarefas = tarefas + provas;
      if (!totalTarefas && !redacoes) {
        if (subtitulo) subtitulo.textContent = 'Você está em dia. Nenhuma pendência no momento.';
        lista.innerHTML = '<div class="pendencias-empty">Nenhuma tarefa ou redação pendente.</div>';
        return;
      }
      if (subtitulo) subtitulo.textContent = 'Veja onde estão suas atividades pendentes na Sala do Futuro.';
      const categorias = [
        { id: 'tarefas', titulo: 'TarefaSP', icone: 'images/tarefasp.png', qtd: totalTarefas, href: '/tarefas', singular: 'pendência', plural: 'pendências' },
        { id: 'redacoes', titulo: 'Redação', icone: 'images/redacaosp.png', qtd: redacoes, href: '/redacao', singular: 'redação pendente', plural: 'redações pendentes' },
      ];
