    function abrirPopupDiscord() {
      const overlay = document.getElementById('discordPopup');
      if (!overlay) return;
      marcarPromoPopupsVistos();
      // Ao fechar o oficial vem o da Platform Destroyer, e só depois a parceria.
      promoAoFechar = abrirPopupPD;
      setTimeout(() => {
        overlay.classList.add('open');
        overlay.setAttribute('aria-hidden', 'false');
        window.App?.lockPageScroll?.();
      }, 800);
    }

    function iniciarCicloPromoPopups() {
      if (!podeMostrarPromoPopups()) return;
      const ids = ['discordPopup', 'pdPopup', 'partnerPopup', 'apoiadorPopup'];
      for (const id of ids) {
        const el = document.getElementById(id);
        if (el?.classList.contains('open')) return;
      }
      abrirPopupDiscord();
    }

    function configurarPromoPopups() {
      if (window._cmspPromoPopupsProntos) return;
      window._cmspPromoPopupsProntos = true;

      document.getElementById('discordPopupClose')?.addEventListener('click', fecharPopupDiscord);
      document.getElementById('discordPopup')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) fecharPopupDiscord(); });
      document.getElementById('pdPopupClose')?.addEventListener('click', fecharPopupPD);
      document.getElementById('pdPopup')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) fecharPopupPD(); });
      document.getElementById('partnerPopupClose')?.addEventListener('click', fecharPopupParceria);
      document.getElementById('apoiadorPopupClose')?.addEventListener('click', fecharPopupApoiador);
      document.getElementById('apoiadorPopup')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) fecharPopupApoiador(); });

      document.addEventListener('click', (e) => {
        if (e.target.closest('#btnApoioBenef')) abrirPopupApoiador();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const order = ['apoiadorPopup', 'partnerPopup', 'pdPopup', 'discordPopup'];
        for (const id of order) {
          const el = document.getElementById(id);
          if (el?.classList.contains('open')) {
            const btn = el.querySelector('.discord-popup-close');
            if (btn && !btn.disabled) btn.click();
            return;
          }
        }
      });

      const couponBtn = document.getElementById('partnerCouponBtn');
      const copyHint = document.getElementById('partnerCopyHint');
      if (couponBtn && copyHint) {
        couponBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('cmsp');
            copyHint.textContent = 'Cupom copiado!';
            copyHint.classList.add('copied');
            setTimeout(() => { copyHint.textContent = 'Clique para copiar'; copyHint.classList.remove('copied'); }, 2000);
          } catch (err) {
            copyHint.textContent = 'Não foi possível copiar automaticamente';
            setTimeout(() => { copyHint.textContent = 'Clique para copiar'; }, 2000);
          }
        });
      }
    }

    function iniciarAgendaPromoPopups() {
      configurarPromoPopups();
      iniciarCicloPromoPopups();
      if (!window._cmspPromoPopupsTimer) {
        window._cmspPromoPopupsTimer = setInterval(iniciarCicloPromoPopups, PROMO_POPUPS_COOLDOWN_MS);
      }
    }

    async function carregarSessao() {
      try {
        const userPromise = App.requireAuth();
        const resumoPromise = carregarResumoInicio();
        const plataformasPromise = carregarPlataformas();
        const user = await userPromise;
        if (!user) return;
        aplicarUsuario(user);
        await Promise.all([resumoPromise, plataformasPromise]);
        iniciarAgendaPromoPopups();
      } catch (error) {
        window.location.href = '/';
      }
    }

    if (!window._cmspLayoutPopstateReady) {
      window._cmspLayoutPopstateReady = true;
      window.addEventListener('popstate', atualizarLayoutPlataformas);
      window.addEventListener('cmsp:navigated', () => {
        atualizarLayoutPlataformas();
        if (document.getElementById('platformGrid')) carregarPlataformas();
      });
    }

    App.marcarNavAtiva(location.pathname === '/plataformas' ? 'plataformas' : 'inicio');
    App.bindLogout();
    document.getElementById('btnVerDoacoes')?.addEventListener('click', () => {
      App.scrollElementIntoView(document.getElementById('doacoesRecentes'), { offset: 16 });
    });

    carregarSessao();
    carregarDadosDoacoes();
    configurarAbasDoacoes();
    configurarModalPendencias();
    if (document.getElementById('faltasPopup')) App.initFaltasModal();
    atualizarLayoutPlataformas();
    configurarPromoPopups();
  })();
</script>

