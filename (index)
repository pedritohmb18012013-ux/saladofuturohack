      const diffD = Math.floor(diffH / 24);
      if (diffD < 7) return `${diffD}d`;
      return data.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' });
    }

    function inicialDoador(nome) {
      const texto = String(nome || '?').trim();
      return texto ? texto.charAt(0).toUpperCase() : '?';
    }

    function corAvatarDoador(index) {
      const cores = [
        'linear-gradient(135deg,#7a7a7a,#4f4f4f)',
        'linear-gradient(135deg,#717171,#414141)',
        'linear-gradient(135deg,#828282,#525252)',
        'linear-gradient(135deg,#858585,#6a6a6a)',
        'linear-gradient(135deg,#a7a7a7,#878787)',
        'linear-gradient(135deg,#7c7c7c,#626262)',
        'linear-gradient(135deg,#858585,#656565)',
        'linear-gradient(135deg,#808080,#666666)',
      ];
      return cores[index % cores.length];
    }

    function pluralizar(qtd, singular, plural) {
      return qtd === 1 ? `1 ${singular}` : `${qtd} ${plural}`;
    }

    function formatarPendenciasDetalhe(pendencias) {
      const partes = [];
      if (pendencias.tarefas) partes.push(pluralizar(pendencias.tarefas, 'tarefa', 'tarefas'));
      if (pendencias.redacoes) partes.push(pluralizar(pendencias.redacoes, 'redação', 'redações'));
      if (pendencias.provas) partes.push(pluralizar(pendencias.provas, 'prova', 'provas'));
      if (!partes.length) return 'Nenhuma pendência';
      return partes.join(' · ');
    }

    function formatarFaltasDetalhe(faltas) {
      const total = Number(faltas.total || 0);
      const disciplinas = faltas.disciplinas || [];
      if (!total) return 'Nenhuma falta no bimestre';
      const comFaltas = disciplinas.filter((item) => Number(item.faltas) > 0);
      if (comFaltas.length === 1) return `${comFaltas[0].disciplina}: ${comFaltas[0].faltas}`;
      if (comFaltas.length > 1) {
        const top = [...comFaltas].sort((a, b) => Number(b.faltas) - Number(a.faltas))[0];
        return `${top.disciplina} · +${comFaltas.length - 1} matéria${comFaltas.length > 2 ? 's' : ''}`;
      }
      return pluralizar(total, 'falta no bimestre', 'faltas no bimestre');
    }

    function aplicarUsuario(user) {
      const nome = user.nome || 'Usuário';
      const subtitulo = user.subtitulo || [user.turma, user.escola].filter(Boolean).join(' · ');
      const inicial = user.inicial || nome.charAt(0).toUpperCase();
      document.getElementById('welcomeTitle').textContent = `${App.saudacao()}, ${nome.split(' ')[0]}`;
      document.getElementById('welcomeSub').textContent = subtitulo || 'Sala do Futuro · SP';
      document.getElementById('welcomeAvatar').textContent = inicial;
      App.aplicarUsuario(user);
    }

    function renderizarPlataformas(lista) {
      const grid = document.getElementById('platformGrid');
      if (!grid) return;
      if (!lista.length) {
        grid.innerHTML = '<div class="platform-empty">Nenhuma plataforma com script disponível na sua conta.</div>';
        return;
      }
      grid.innerHTML = lista.map((item) => {
        const status = item.status || (item.ativo === false ? 'em_breve' : 'online');
        const apoiador = !!item.apoiador;
        const liberada = status === 'online' && (!item.apoiadorOnly || apoiador);
        const tag = liberada ? 'a' : 'div';
        const href = liberada ? ` href="${escapeHtml(item.href)}"` : '';
        let badge = '';
        if (item.apoiadorOnly && !apoiador) badge = '<span class="platform-badge is-apoiador">Apoiador</span>';
        else if (status === 'update') badge = '<span class="platform-badge is-update">Update</span>';
        else if (status !== 'online') badge = '<span class="platform-badge">Em breve</span>';
        return `
        <${tag} class="platform-item${liberada ? '' : ' is-disabled'}${status === 'update' ? ' is-update' : ''}"${href} style="text-decoration:none;color:inherit;">
          <div class="item-icon"><img src="${escapeHtml(item.icon)}" alt="${escapeHtml(item.name)}" /></div>
