        if (donationsRes.ok) {
          const donations = await donationsRes.json();
          _donationsData = donations.donations || donations.items || donations.data || [];
        }

        if (rankingRes.ok) {
          const ranking = await rankingRes.json();
          _rankingData = ranking.donations || ranking.items || ranking.data || [];
