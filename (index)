    function renderizarRanking(items) {
      const topName = document.getElementById('topDonorName');
      const topAmount = document.getElementById('topDonorAmount');
      const lista = document.getElementById('donorList');
      const loading = document.getElementById('donationsLoading');
      if (!lista) return;
