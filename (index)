          if (cat.id === 'tarefas') {
            if (provas && tarefas) statusText = `${pluralizar(totalTarefas, 'pendência', 'pendências')} · ${pluralizar(tarefas, 'tarefa', 'tarefas')} · ${pluralizar(provas, 'prova', 'provas')}`;
            else if (provas) statusText = pluralizar(provas, 'prova pendente', 'provas pendentes');
            else statusText = pluralizar(tarefas, 'tarefa pendente', 'tarefas pendentes');
          } else statusText = pluralizar(cat.qtd, cat.singular, cat.plural);
        }
        return `<div class="pendencias-categoria${vazio ? ' is-empty' : ''}">
          <div class="pendencias-cat-icon"><img src="${cat.icone}" alt="" /></div>
          <div class="pendencias-cat-info"><h4>${cat.titulo}</h4>${vazio ? '<p class="is-ok">Nenhuma pendência</p>' : `<p>${statusText}</p>`}</div>
          <a class="pendencias-cat-go${vazio ? ' is-disabled' : ''}" href="${cat.href}" aria-label="Ir para ${cat.titulo}">
