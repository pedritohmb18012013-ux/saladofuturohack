    async function carregarDadosDoacoes() {
      try {
        const [statsRes, donationsRes, rankingRes] = await Promise.all([
          fetch('/api/doacoes/stats', { credentials: 'same-origin' }),
          fetch('/api/doacoes/recentes?limit=10', { credentials: 'same-origin' }),
          fetch('/api/doacoes/ranking?limit=10', { credentials: 'same-origin' }),
        ]);

        if (statsRes.ok) {
